# Copy to .env (local) and add the same keys in Vercel > Project > Settings > Environment Variables.
# Values come from the NEW Nyala Labs Supabase project (Settings > API).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: Google OAuth client ID for "Draft IO in Gmail" (authorized origin = your Vercel URL).
VITE_GMAIL_CLIENT_ID=
